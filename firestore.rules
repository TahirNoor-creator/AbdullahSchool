rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tvhome67617@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins collection
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isBootstrappedAdmin();
      allow write: if isBootstrappedAdmin();
    }

    // School configuration
    match /school_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Campuses
    match /campuses/{campusId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Students
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Fee Invoices
    match /fee_invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Fee Payments
    match /fee_payments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Audit logs (append-only)
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }
  }
}
